{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RolePlayingTech/agent-harness-kit/main/docs/schemas/feature-list.schema.json",
  "title": "AI Agent Harness Feature & Task Ledger",
  "description": "Default-FAIL task ledger schema for multi-session AI coding agents. Every feature starts as 'pending' and transitions to 'verified' only after deterministic command execution.",
  "type": "object",
  "required": ["project", "features"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["greenfield", "brownfield", "monorepo"]
    },
    "testingProfile": {
      "type": "string",
      "enum": ["fast-prototype", "smart-tiered", "isolated-verifier", "mission-critical"]
    },
    "contextPolicy": {
      "type": "string",
      "enum": ["strict", "balanced", "expansive"]
    },
    "securityTier": {
      "type": "string",
      "enum": ["tier-0-readonly", "tier-1-workspace-safe", "tier-2-network-dev", "tier-3-human-gated"]
    },
    "updatedAt": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "verification"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "verified", "blocked"],
            "description": "Default-FAIL state. Must remain 'pending' or 'in_progress' until verification command exits with code 0."
          },
          "verification": {
            "type": "string",
            "minLength": 3,
            "description": "Exact deterministic command or check required to prove completion."
          },
          "verifiedAt": {
            "type": ["string", "null"],
            "description": "ISO-8601 timestamp recorded only after the verification command passes."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
