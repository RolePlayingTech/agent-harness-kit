{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RolePlayingTech/agent-harness-kit/main/docs/schemas/feature-list.schema.json",
  "title": "AI Agent Harness Feature & Task Ledger",
  "description": "Default-FAIL task ledger schema for multi-session AI coding agents. Every feature starts as 'pending' and transitions to 'verified' only after deterministic command execution.",
  "type": "object",
  "required": ["project", "testingProfile", "contextPolicy", "features"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "harnessVersion": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["greenfield", "brownfield", "brownfield-monorepo"]
    },
    "testingProfile": {
      "type": "string",
      "enum": ["fast-prototype", "smart-tiered", "isolated-verifier", "mission-critical"]
    },
    "contextPolicy": {
      "type": "string",
      "enum": ["minimal", "balanced", "deep-research", "low-cost"]
    },
    "updatedAt": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "verificationCommand"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "failed", "verified"],
            "description": "Default-FAIL state. Must remain 'pending' or 'in_progress' until verificationCommand exits with code 0."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9-]+$"
            }
          },
          "verificationCommand": {
            "type": "string",
            "minLength": 2,
            "description": "Exact deterministic command required to prove completion."
          },
          "verificationEvidence": {
            "type": ["null", "string", "object"],
            "description": "Recorded only after verificationCommand exits 0."
          },
          "nextAction": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
