{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RolePlayingTech/agent-harness-kit/main/schema/spec.schema.json",
  "title": "agent-harness-kit spec",
  "description": "Decisions from which agent-harness-kit generates a repository's agent harness. Edit, then run `agent-harness build`.",
  "type": "object",
  "required": ["specVersion", "project", "agents", "verification", "memory", "approvals", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "summary", "stage", "stack", "layout"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "description": "One sentence: what the project is and for whom. Opens AGENTS.md." },
        "stage": { "enum": ["new", "existing"] },
        "stack": { "type": "array", "items": { "type": "string" } },
        "layout": {
          "type": "array",
          "items": { "type": "object", "required": ["path", "purpose"], "properties": { "path": { "type": "string" }, "purpose": { "type": "string" } } }
        },
        "packageManager": { "type": ["string", "null"] },
        "testFrameworks": { "type": "array", "items": { "type": "string" } },
        "workspaces": { "type": "array", "items": { "type": "string" } },
        "sourceFiles": { "type": "integer" },
        "sensitive": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["codex", "claude", "cursor", "other"] }
    },
    "verification": {
      "type": "object",
      "required": ["rigor"],
      "properties": {
        "rigor": { "enum": ["light", "standard", "strict"] },
        "fast": { "type": ["string", "null"], "pattern": "^[^\\r\\n]+$" },
        "full": { "type": ["string", "null"], "pattern": "^[^\\r\\n]+$" },
        "e2e": { "type": ["string", "null"], "pattern": "^[^\\r\\n]+$" }
      }
    },
    "memory": { "enum": ["none", "decisions", "handoff"] },
    "approvals": {
      "type": "array",
      "description": "Approval ids or custom one-line sentences.",
      "items": { "type": "string" }
    },
    "rules": { "type": "array", "items": { "type": "string", "pattern": "^[^\\r\\n]+$" } },
    "overrides": {
      "type": "object",
      "propertyNames": { "enum": ["verify-change", "quiet-output", "exploration", "workspace-scope", "risk-areas", "harness-maintenance"] },
      "additionalProperties": { "type": "boolean" }
    },
    "tooling": { "type": "object", "properties": { "cli": { "type": "string", "minLength": 1 } } },
    "budget": { "type": "object", "properties": { "alwaysOnLines": { "type": "integer", "minimum": 20 } } }
  }
}
